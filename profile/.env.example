# Environment for the Hermes `stock-trader` profile (~/.hermes/profiles/stock-trader/.env).
#
# scripts/install-profile.sh copies this file to the profile's .env once and never
# overwrites it. Fill in the blank keys and model ids, then restart the gateway.
#
# Keep every variable below in the file WITH a value, even when you keep the default:
# Hermes passes `${VAR}` references in config.yaml to trader-broker, and a variable that
# is missing or empty reaches the server as the literal text `${VAR}`. The one exception
# is TRADER_BROKER_LIVE_ACK, which stays empty in paper mode.
#
# trader-broker reads its settings only when it starts; restart the gateway after a change.

# --- Hermes model (the proposer) -----------------------------------------------------
# Anthropic API key for the Claude model set in config.yaml.
ANTHROPIC_API_KEY=

# --- Alpaca ----------------------------------------------------------------------------
# Alpaca API key id and secret. Use paper-account keys while TRADER_BROKER_MODE=paper.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Mode and state --------------------------------------------------------------------
# paper (default) or live. Live trades real money.
TRADER_BROKER_MODE=paper
# Live mode also needs this set to exactly I_ACCEPT_REAL_MONEY_RISK; leave empty for paper.
TRADER_BROKER_LIVE_ACK=
# Directory for the state database and logs; each mode gets its own subdirectory.
TRADER_BROKER_STATE_DIR=~/.local/share/trader-broker
# Seconds a tool call waits for another trader-broker process on the account before it
# answers busy. Keep it plus the longest call (about 120 s) under the 300 s MCP timeout.
TRADER_ACCOUNT_LOCK_WAIT_S=60

# --- Risk caps (fractions: 0.03 means 3%) ------------------------------------------------
# Share of equity one trade may lose if its stop is hit; sets the share count.
TRADER_RISK_PCT=0.03
# Largest share of equity one symbol's position may take.
TRADER_SYMBOL_CAP_PCT=0.20
# Loss from the day's starting equity that halts new buys for the rest of the day.
TRADER_DAILY_LOSS_PCT=0.04
# Drawdown from peak equity that trips the kill switch (no buys until reset by hand).
TRADER_KILL_DRAWDOWN_PCT=0.20
# Lowest share price, in USD, the server will buy.
TRADER_MIN_PRICE=5
# Lowest average daily dollar volume, in USD, a symbol needs to be bought.
TRADER_MIN_ADV_USD=20000000
# Minutes an unfilled entry order may rest before it is cancelled.
TRADER_ENTRY_TTL_MINUTES=30
# Allowed move above the quoted price when setting the entry limit.
TRADER_ENTRY_SLIPPAGE_PCT=0.005
# Minutes before the close during which no new buy may start.
TRADER_NO_ENTRY_BEFORE_CLOSE_MINUTES=30
# Smallest allowed stop distance, as a share of the entry price.
TRADER_MIN_STOP_PCT=0.005
# Largest allowed stop distance, as a share of the entry price.
TRADER_MAX_STOP_PCT=0.25

# --- Trade reviewers (OpenAI-compatible chat completions) ---------------------------------
# Seconds each reviewer call may take; a failed call is retried once.
REVIEWER_TIMEOUT_S=60
# Reviewer 1: provider label, API base URL, model id (required, no default) and the name
# of the variable that holds its API key.
REVIEWER_1_PROVIDER=openai
REVIEWER_1_BASE_URL=https://api.openai.com/v1
REVIEWER_1_MODEL=
REVIEWER_1_API_KEY_ENV=OPENAI_API_KEY
# Reviewer 2: same fields.
REVIEWER_2_PROVIDER=xai
REVIEWER_2_BASE_URL=https://api.x.ai/v1
REVIEWER_2_MODEL=
REVIEWER_2_API_KEY_ENV=XAI_API_KEY
# API keys named by REVIEWER_n_API_KEY_ENV above.
OPENAI_API_KEY=
XAI_API_KEY=

# --- Report delivery -----------------------------------------------------------------------
# Where scheduled jobs post their reports, as Hermes cron deliver targets. Each chat must
# also be routed to this profile in the default profile's gateway.profile_routes
# (see profile_routes.example.yaml). Examples: discord:<channel_id>, telegram:<group_chat_id>.
TRADER_DISCORD_TARGET=
TRADER_TELEGRAM_TARGET=
